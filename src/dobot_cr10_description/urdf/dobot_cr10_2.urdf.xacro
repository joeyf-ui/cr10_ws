<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="dobot_cr10">

  <xacro:arg name="prefix" default=""/>

  <!-- MATERIAL -->
  <material name="dobot_blue">
    <color rgba="0.3 0.5 0.8 1"/>
  </material>

  <!-- BASE LINK -->
  <link name="$(arg prefix)base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0.0"
               iyy="0.01" iyz="0.0" izz="0.01"/>
    </inertial>
    <visual>
      <geometry><box size="0.1 0.1 0.05"/></geometry>
      <material name="dobot_blue"/>
    </visual>
    <collision>
      <geometry><box size="0.1 0.1 0.05"/></geometry>
    </collision>
  </link>

  <!-- LINK 1 -->
  <link name="$(arg prefix)link_1">
    <inertial>
      <origin xyz="0 0 0.1" rpy="0 0 0"/>
      <mass value="4.0"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0.0"
               iyy="0.01" iyz="0.0" izz="0.01"/>
    </inertial>
    <visual>
      <geometry><box size="0.05 0.05 0.2"/></geometry>
      <material name="dobot_blue"/>
    </visual>
    <collision>
      <geometry><box size="0.05 0.05 0.2"/></geometry>
    </collision>
  </link>

  <!-- LINK 2 -->
  <link name="$(arg prefix)link_2">
    <inertial>
      <origin xyz="0 0 0.15" rpy="0 0 0"/>
      <mass value="4.0"/>
      <inertia ixx="0.02" ixy="0.0" ixz="0.0"
               iyy="0.02" iyz="0.0" izz="0.02"/>
    </inertial>
    <visual>
      <geometry><box size="0.05 0.05 0.3"/></geometry>
      <material name="dobot_blue"/>
    </visual>
    <collision>
      <geometry><box size="0.05 0.05 0.3"/></geometry>
    </collision>
  </link>

  <!-- LINK 3 -->
  <link name="$(arg prefix)link_3">
    <inertial>
      <origin xyz="0 0 0.15" rpy="0 0 0"/>
      <mass value="3.0"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0.0"
               iyy="0.01" iyz="0.0" izz="0.01"/>
    </inertial>
    <visual>
      <geometry><box size="0.04 0.04 0.3"/></geometry>
      <material name="dobot_blue"/>
    </visual>
    <collision>
      <geometry><box size="0.04 0.04 0.3"/></geometry>
    </collision>
  </link>

  <!-- LINK 4 -->
  <link name="$(arg prefix)link_4">
    <inertial>
      <origin xyz="0 0 0.1" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.005" ixy="0.0" ixz="0.0"
               iyy="0.005" iyz="0.0" izz="0.005"/>
    </inertial>
    <visual>
      <geometry><box size="0.03 0.03 0.2"/></geometry>
      <material name="dobot_blue"/>
    </visual>
    <collision>
      <geometry><box size="0.03 0.03 0.2"/></geometry>
    </collision>
  </link>

  <!-- LINK 5 -->
  <link name="$(arg prefix)link_5">
    <inertial>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <mass value="0.8"/>
      <inertia ixx="0.003" ixy="0.0" ixz="0.0"
               iyy="0.003" iyz="0.0" izz="0.003"/>
    </inertial>
    <visual>
      <geometry><box size="0.02 0.02 0.1"/></geometry>
      <material name="dobot_blue"/>
    </visual>
    <collision>
      <geometry><box size="0.02 0.02 0.1"/></geometry>
    </collision>
  </link>

  <!-- LINK 6 -->
  <link name="$(arg prefix)link_6">
    <inertial>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.002" ixy="0.0" ixz="0.0"
               iyy="0.002" iyz="0.0" izz="0.002"/>
    </inertial>
    <visual>
      <geometry><box size="0.02 0.02 0.08"/></geometry>
      <material name="dobot_blue"/>
    </visual>
    <collision>
      <geometry><box size="0.02 0.02 0.08"/></geometry>
    </collision>
  </link>

  <!-- TOOL -->
  <link name="$(arg prefix)tool0"/>
  <joint name="$(arg prefix)link_6_tool0" type="fixed">
    <parent link="$(arg prefix)link_6"/>
    <child link="$(arg prefix)tool0"/>
    <origin xyz="0.05 0 0" rpy="0 0 0"/>
  </joint>

  <!-- JOINTS -->
  <joint name="$(arg prefix)joint_1" type="revolute">
    <parent link="$(arg prefix)base_link"/>
    <child link="$(arg prefix)link_1"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.28" upper="6.28" effort="150" velocity="2"/>
  </joint>

  <joint name="$(arg prefix)joint_2" type="revolute">
    <parent link="$(arg prefix)link_1"/>
    <child link="$(arg prefix)link_2"/>
    <origin xyz="0 0 0.2" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-3.14" upper="3.14" effort="150" velocity="2"/>
  </joint>

  <joint name="$(arg prefix)joint_3" type="revolute">
    <parent link="$(arg prefix)link_2"/>
    <child link="$(arg prefix)link_3"/>
    <origin xyz="0 0 0.3" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-6.28" upper="6.28" effort="100" velocity="2"/>
  </joint>

  <joint name="$(arg prefix)joint_4" type="revolute">
    <parent link="$(arg prefix)link_3"/>
    <child link="$(arg prefix)link_4"/>
    <origin xyz="0 0 0.3" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-6.28" upper="6.28" effort="50" velocity="3"/>
  </joint>

  <joint name="$(arg prefix)joint_5" type="revolute">
    <parent link="$(arg prefix)link_4"/>
    <child link="$(arg prefix)link_5"/>
    <origin xyz="0 0 0.2" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.28" upper="6.28" effort="50" velocity="3"/>
  </joint>

  <joint name="$(arg prefix)joint_6" type="revolute">
    <parent link="$(arg prefix)link_5"/>
    <child link="$(arg prefix)link_6"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-6.28" upper="6.28" effort="30" velocity="3"/>
  </joint>

</robot>


